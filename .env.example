# ═══════════════════════════════════════════════
# AI Harness — 环境变量模板（复制为 .env 后修改）
#
# 使用：
#   1. cp .env.example .env
#   2. 修改 AIH_TOKEN（生产环境必填）
#   3. docker compose up -d --build
# ═══════════════════════════════════════════════

# ── 基础连接 ──
AIH_HOST=0.0.0.0
AIH_PORT=8765

# ── 工作目录（Agent 读写文件的根目录） ──
# Docker 里默认 /workspace，挂载到 ./workspace
AIH_WORKDIR=/workspace

# ── API 安全令牌 ⚠️ 生产环境必须设置 ──
# 设了之后所有 /api/* 需要 Authorization: Bearer <token>
# 不设则完全开放（开发模式）
# AIH_TOKEN=change-me-to-a-long-random-string

# ── 沙箱模式 ──
# true:  Agent 只能访问工作区（安全，禁止 Shell/进程/删除）
# false: Agent 拥有完整 Root 权限（生产谨慎）
AIH_SANDBOX=true
